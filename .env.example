# Get a key at https://console.anthropic.com (billed separately from a Claude.ai subscription).
ANTHROPIC_API_KEY=

# Optional: which Claude model to use. Defaults to claude-opus-5-5.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: set to 1 to return fixed sample answers without calling Claude (UI work only).
# MOCK_CLAUDE=1

# Optional: the key `npm run eval` uses in a Claude Code cloud session, where
# ANTHROPIC_API_KEY is hidden from the commands Claude runs.
# KEIGO_EVAL_KEY=
